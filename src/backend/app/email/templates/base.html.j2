<!doctype html>
<html lang="pl">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ subject }}</title>
</head>
<body style="margin:0;padding:0;background:#f4f8f0;">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background:#f4f8f0;">
<tr><td align="center" style="padding:24px 12px;">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="max-width:600px;background:#ffffff;border:1px solid #e2eadf;border-radius:16px;">
<tr><td style="padding:28px;font-family:Arial,Helvetica,sans-serif;color:#1e2e27;">
<div style="color:#ff6a0d;font-weight:800;font-size:22px;margin:0 0 18px;">{{ brand }}</div>
<h2 style="font-size:20px;margin:0 0 10px;color:#1e2e27;">{{ subject }}</h2>
{% for paragraph in paragraphs %}
<p style="font-size:15px;line-height:1.5;color:#1e2e27;margin:0 0 14px;">{{ paragraph }}</p>
{% endfor %}
{% if cta_url is defined %}
<p style="margin:4px 0 8px;"><a href="{{ cta_url }}" style="display:inline-block;background:#1b8168;color:#ffffff;border-radius:999px;padding:12px 22px;font-weight:700;font-size:15px;text-decoration:none;">{{ cta_label }}</a></p>
<p style="font-size:12px;line-height:1.5;color:#5c7069;margin:0 0 14px;word-break:break-all;">{{ cta_url }}</p>
{% endif %}
{% if note is defined %}
<p style="margin:14px 0 0;font-size:13px;line-height:1.5;color:#5c7069;">{{ note }}{% if note_link_url is defined %} <a href="{{ note_link_url }}" style="color:#117b63;">{{ note_link_url }}</a>{% endif %}</p>
{% endif %}
<div style="font-size:12px;color:#5c7069;margin-top:22px;border-top:1px solid #e2eadf;padding-top:14px;line-height:1.5;">
{% if unsubscribe_url is defined %}
Dostajesz ten mail, bo masz włączone powiadomienia „{{ category_label }}”.<br>
<a href="{{ unsubscribe_url }}" style="color:#117b63;">Wypisz się z tej kategorii</a> · <a href="{{ settings_url }}" style="color:#117b63;">Ustawienia powiadomień</a>
{% else %}
Wiadomość o Twoim koncie w {{ brand }}, wysyłana niezależnie od ustawień powiadomień.
{% endif %}
</div>
</td></tr>
</table>
</td></tr>
</table>
</body>
</html>
