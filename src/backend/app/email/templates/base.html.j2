<!doctype html>
<html lang="pl">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="color-scheme" content="light">
<title>{{ subject }}</title>
</head>
<body style="margin:0;padding:0;background:#f4f8f0;">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background:#f4f8f0;">
<tr><td align="center" style="padding:28px 12px 32px;">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="max-width:600px;">
<tr><td align="center" style="padding:0 0 18px;">
<a href="{{ base_url }}/" style="text-decoration:none;color:#1e2e27;">
<img src="{{ logo_url }}" width="56" height="56" alt="" style="display:inline-block;width:56px;height:56px;border:0;border-radius:14px;background:#ffffff;vertical-align:middle;">
<span style="display:inline-block;vertical-align:middle;margin-left:10px;font-family:Arial,Helvetica,sans-serif;font-size:26px;font-weight:800;letter-spacing:-0.5px;color:#ff6a0d;">{{ brand }}</span>
</a>
</td></tr>
<tr><td style="background:#ffffff;border:1px solid #e2eadf;border-top:5px solid #1b8168;border-radius:18px;padding:32px 30px 28px;font-family:Arial,Helvetica,sans-serif;color:#1e2e27;">
<h2 style="font-size:22px;line-height:1.3;margin:0 0 16px;color:#1e2e27;">{{ subject }}</h2>
{% for paragraph in paragraphs %}
<p style="font-size:16px;line-height:1.6;color:#1e2e27;margin:0 0 16px;">{{ paragraph }}</p>
{% endfor %}
{% if cta_url is defined %}
<table role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin:8px 0 20px;">
<tr><td style="background:#1b8168;border-radius:999px;">
<a href="{{ cta_url }}" style="display:inline-block;padding:14px 28px;font-family:Arial,Helvetica,sans-serif;font-size:16px;font-weight:700;color:#ffffff;text-decoration:none;border-radius:999px;">{{ cta_label }}</a>
</td></tr>
</table>
<p style="font-size:12px;line-height:1.5;color:#5c7069;margin:0 0 4px;">Jeśli przycisk nie działa, skopiuj ten link do przeglądarki:</p>
<p style="font-size:12px;line-height:1.5;margin:0 0 16px;word-break:break-all;"><a href="{{ cta_url }}" style="color:#117b63;">{{ cta_url }}</a></p>
{% endif %}
{% if note is defined %}
<p style="margin:16px 0 0;padding:12px 14px;background:#f4f8f0;border-radius:12px;font-size:13px;line-height:1.5;color:#5c7069;">{{ note }}{% if note_link_url is defined %} <a href="{{ note_link_url }}" style="color:#117b63;">{{ note_link_url }}</a>{% endif %}</p>
{% endif %}
</td></tr>
<tr><td align="center" style="padding:20px 16px 0;font-family:Arial,Helvetica,sans-serif;font-size:12px;line-height:1.6;color:#5c7069;">
{% if unsubscribe_url is defined %}
Dostajesz ten mail, bo masz włączone powiadomienia „{{ category_label }}”.<br>
<a href="{{ unsubscribe_url }}" style="color:#117b63;">Wypisz się z tej kategorii</a> · <a href="{{ settings_url }}" style="color:#117b63;">Ustawienia powiadomień</a>
{% else %}
Wiadomość o Twoim koncie w {{ brand }}, wysyłana niezależnie od ustawień powiadomień.
{% endif %}
<br><span style="color:#8a9a93;">{{ brand }} · wymieniaj się rzeczami w swojej okolicy</span>
</td></tr>
</table>
</td></tr>
</table>
</body>
</html>
