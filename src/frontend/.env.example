# Google Maps JavaScript API (Places API (New)) key:
# referrer-restricted browser key; leave empty for manual mode.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Google OAuth 2.0 Web client ID for "Zaloguj przez Google": the same value as
# the backend's GOOGLE_CLIENT_ID. No redirect URIs and no client secret; empty
# hides the button. Inlined at build time: restart `next dev` / rebuild `web`
# after a change. Over plain http (dev :5173, compose :5174) the backend needs
# AUTH_COOKIE_SECURE=false, otherwise Safari drops the nonce cookie.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
