# JWT signing secret (HS256). Required. Never commit the real value.
JWT_SECRET=change-me

# JWT access token lifetime, in milliseconds.
JWT_EXPIRATION_MS=3600000

# Comma-separated list of allowed CORS origins.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Base URI prepended to footprint RFC7807 problem `type` values (kebab-case
# error code appended). Normalized to end with a trailing slash.
FOOTPRINT_PROBLEM_BASE_URI=https://aj.example.com/problems/

# Async SQLAlchemy connection string (asyncpg driver).
DATABASE_URL=postgresql+asyncpg://aj:aj@localhost:5432/aj

# Footprint audit background-task retry policy (tenacity), matches the Java
# @Retryable/@Backoff defaults (app.footprint.audit.retry.*).
FOOTPRINT_AUDIT_RETRY_MAX_ATTEMPTS=3
FOOTPRINT_AUDIT_RETRY_DELAY_MS=200
FOOTPRINT_AUDIT_RETRY_MULTIPLIER=2.0

# Photo storage: DigitalOcean Spaces (S3 API). Photo upload stays disabled
# until all six are set. Use a per-bucket limited access key (read/write/delete).
SPACES_ENDPOINT_URL=https://fra1.digitaloceanspaces.com
SPACES_REGION=fra1
SPACES_BUCKET=groupthing-dev
SPACES_KEY=
SPACES_SECRET=
# Public CDN base URL of the bucket (approved photos are served from here).
SPACES_PUBLIC_BASE_URL=https://groupthing-dev.fra1.cdn.digitaloceanspaces.com

# Content moderation. Two independent flags, both off by default.
# Note: MODERATION_ENABLED was renamed to MODERATION_IMAGE_ENABLED and is now
# ignored (the API and worker log a warning at startup while it is still set).
#
# Text: names/descriptions are scored synchronously in the API with Bielik-Guard
# and rejected (400) when any category score >= the threshold. Needs the
# production `runtime` image (bakes in the model); the dev compose image has no
# model, so keep it false there.
MODERATION_TEXT_ENABLED=false
MODERATION_TEXT_REJECT_THRESHOLD=0.8
# Where the API image keeps the exported ONNX model (`<dir>/text`).
MODERATION_MODELS_DIR=/models
#
# Photos: false approves new photos at once. true keeps them PENDING until the
# moderation worker (`python -m app.moderation.worker`) scores them via VPS B.
# Set it on both the API and the worker.
MODERATION_IMAGE_ENABLED=false
# Per ShieldGemma-2 category (sexual/violence/dangerous): score >= review ->
# NEEDS_REVIEW, >= reject -> REJECTED. `weapons` only ever goes to review.
MODERATION_IMAGE_REVIEW_THRESHOLD=0.5
MODERATION_IMAGE_REJECT_THRESHOLD=0.9
# VPS B image moderation service (POST /v1/moderate/image), worker only.
# Required when MODERATION_IMAGE_ENABLED=true; the token is a bearer secret.
# Must be https, except plain http to a private-network IP (e.g. 10.x VPC).
MODERATION_AI_URL=
MODERATION_AI_TOKEN=
# Per-call timeout for VPS B, in seconds.
MODERATION_AI_TIMEOUT_SECONDS=120
