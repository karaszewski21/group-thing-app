# JWT signing secret (HS256). Required. Never commit the real value.
JWT_SECRET=change-me

# JWT access token lifetime, in milliseconds.
JWT_EXPIRATION_MS=3600000

# Comma-separated list of allowed CORS origins.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Base URI prepended to footprint RFC7807 problem `type` values (kebab-case
# error code appended). Normalized to end with a trailing slash.
FOOTPRINT_PROBLEM_BASE_URI=https://aj.example.com/problems/

# Async SQLAlchemy connection string (asyncpg driver).
DATABASE_URL=postgresql+asyncpg://aj:aj@localhost:5432/aj

# Footprint audit background-task retry policy (tenacity), matches the Java
# @Retryable/@Backoff defaults (app.footprint.audit.retry.*).
FOOTPRINT_AUDIT_RETRY_MAX_ATTEMPTS=3
FOOTPRINT_AUDIT_RETRY_DELAY_MS=200
FOOTPRINT_AUDIT_RETRY_MULTIPLIER=2.0

# Photo storage: DigitalOcean Spaces (S3 API). Photo upload stays disabled
# until all six are set. Use a per-bucket limited access key (read/write/delete).
SPACES_ENDPOINT_URL=https://fra1.digitaloceanspaces.com
SPACES_REGION=fra1
SPACES_BUCKET=groupthing-dev
SPACES_KEY=
SPACES_SECRET=
# Public CDN base URL of the bucket (approved photos are served from here).
SPACES_PUBLIC_BASE_URL=https://groupthing-dev.fra1.cdn.digitaloceanspaces.com

# Content moderation. Two independent flags, both off by default.
# Note: MODERATION_ENABLED was renamed to MODERATION_IMAGE_ENABLED and is now
# ignored (the API and worker log a warning at startup while it is still set).
#
# Text: names/descriptions are scored synchronously in the API with Bielik-Guard
# and rejected (400) when any category score >= the threshold. Needs the
# production `runtime` image (bakes in the model); the dev compose image has no
# model, so keep it false there.
MODERATION_TEXT_ENABLED=false
MODERATION_TEXT_REJECT_THRESHOLD=0.8
# Where the API image keeps the exported ONNX model (`<dir>/text`).
MODERATION_MODELS_DIR=/models
#
# Photos: false approves new photos at once. true keeps uploads PENDING until
# VPS B's `moderation-cron` (group-thing-ai) decides them; enable only together
# with MODERATION_CRON_ENABLED on VPS B. Thresholds live in VPS B's .env.cron.
MODERATION_IMAGE_ENABLED=false

# Wants SIMILAR tier: embeds product and want names in the API with the int8
# mmlw-roberta-base model baked into the `runtime` image (`<dir>/model.onnx`).
# Off by default. Compose builds the `runtime` target, which contains
# /models/embed; only the `runtime-dev` target has no model, so keep it false
# there. Deploys start with false and flip it after a health check (runbook).
EMBEDDINGS_ENABLED=false
EMBEDDINGS_MODEL_DIR=/models/embed

# Google Maps JavaScript API (Places API (New)) key for the frontend build:
# referrer-restricted browser key; leave empty for manual mode. The place
# form's pin map also needs the Geocoding API, the item page's map the Maps
# Embed API enabled on the same key.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Sign in with Google (Google Identity Services ID token, verified by the
# backend). GOOGLE_CLIENT_ID (backend) and NEXT_PUBLIC_GOOGLE_CLIENT_ID
# (frontend build) hold the same OAuth 2.0 Web client ID. No redirect URIs and
# no client secret are needed; add the app's origins as Authorised JavaScript
# origins. Leave both empty to hide the button (the API answers 503).
# NEXT_PUBLIC_GOOGLE_CLIENT_ID is inlined at build time: rebuild `web` after a
# change.
GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# Secure flag on the sign-in nonce cookie; empty = true (compose default). Keep
# it over https; set false over plain http (dev :5173, compose :5174), otherwise
# Safari drops the cookie and every Google sign-in fails with 401.
AUTH_COOKIE_SECURE=
